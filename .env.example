# Development: /api is proxied by Vite to the backend (without /api prefix).
VITE_API_URL=/api
# Optional Photon-compatible reverse-geocoding endpoint (public URL, no secret).
VITE_REVERSE_GEOCODING_URL=https://photon.komoot.io/reverse
# Local development backend. Production uses .env.production instead.
API_PROXY_TARGET=http://localhost:5000
# Must match backend Google:ClientId (Google__ClientId in its environment).
# This is a public Web OAuth client ID, never a client secret.
# Docker passes this public ID from .env.local when building the image.
# After changing it: docker compose --env-file .env.local up -d --build frontend
VITE_GOOGLE_CLIENT_ID=
# Docker Compose (FE only): browser uses /api; Nginx proxies to the host BE.
FE_PORT=5173
BACKEND_URL=http://host.docker.internal:5000
# VITE_* values above are public build-time settings; rebuild after changing them.
# BACKEND_URL is runtime-only, must have no trailing slash or API path.
